# Обязательно: адрес сервера на datalab (тот, что пробрасывает платформа)
DATALAB_URL=https://<наружный-адрес-datalab>/<порт>
# Обязательно: токен jupyterhub. Проверяет его платформа, не наш код.
DATALAB_TOKEN=<JUPYTERHUB_API_TOKEN>

# Необязательные
VERIFY_TLS=false
HTTP_TIMEOUT=120

# --- Установка зависимостей (setup.bat -> setup/setup.py) ---
# true - ставить из корпоративного репозитория, false - из интернета (pypi.org)
PIP_USE_CORPORATE=false
# Хост корпоративного pypi без схемы и пути; путь индекса фиксирован: /repo/pypi/simple
PIP_INDEX_HOST=my_company.ru
# Токен доступа к корпоративному репозиторию (не попадает в git)
PIP_TOKEN=

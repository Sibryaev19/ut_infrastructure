# Сервер на datalab читает только переменные окружения (.env не используется).

# Обязательно: проектные области через ";", формат name=/abs/path
WORKSPACES=gigacode=/home/datalab/nfs/other/gigacode_test;data=/home/datalab/nfs/other/data

# Порт, который пробрасывает платформа
PORT=9999

# Куда складывать полные логи, не влезшие в ответ агенту
SPILL_DIR=/tmp/datalab_mcp

LOG_LEVEL=info

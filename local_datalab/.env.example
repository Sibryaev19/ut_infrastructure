# Путь проекта на хосте (абсолютный). Нужен для маунтов compose и конфига hub.
# setup подставит его автоматически, но можно править вручную.
HOST_BASE_DIR=/absolute/path/to/local_datalab

# Порт хоста, на котором доступен hub (внутри контейнера всегда 8000)
HUB_PORT=8000

# Имя docker-сети, в которой живут hub и пользовательские контейнеры
NETWORK_NAME=local_datalab_datalab

# --- client.py: обязательные ---
DATALAB_URL=https://<наружный-адрес-datalab>/<порт>
DATALAB_TOKEN=<JUPYTERHUB_API_TOKEN>

# --- client.py: необязательные (значения по умолчанию) ---
CLIENT_PORT=7000
CHUNK_SIZE=4194304
MAX_BODY=67108864
HTTP_TIMEOUT=120
VERIFY_TLS=false

# --- server.py: на datalab, .env НЕ читает, только переменные окружения ---
# UPLOAD_DIR=/home/datalab/nfs/other/gigacode_test/data
# JUPYTERHUB_API_TOKEN=<тот же токен>
# PORT=9999
# CHUNK_LIMIT=33554432
